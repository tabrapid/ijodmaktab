# PostgreSQL ulanishi (docker compose up -d bilan mos keladi)
DATABASE_URL="postgresql://ijod:ijod@localhost:5432/ijod?schema=public"

# Avtomatik testlar uchun alohida baza (test:e2e uni tozalab qayta yaratadi)
TEST_DATABASE_URL="postgresql://ijod:ijod@localhost:5432/ijod_test?schema=public"

# API porti
PORT=4000

# Veb-ilova manzili (CORS va havolalar uchun)
WEB_ORIGIN="http://localhost:3000"

# Maxfiy ma'lumotlarni (TOTP kalitlari) shifrlash kaliti: 32 bayt, base64.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="CHANGE_ME_generate_with_node_crypto_32_bytes_b64="

# Cookie faqat HTTPS orqali yuborilsin (productionda true)
COOKIE_SECURE=false

# Kirish sessiyasining amal qilish muddati (soat)
SESSION_TTL_HOURS=12

# Yuklangan fayllar va eksportlar saqlanadigan papka
STORAGE_DIR="./storage"

# Muddat tugagach tarmoq kechikishi uchun ruxsat etilgan qo'shimcha soniyalar (0 — qat'iy)
ANSWER_GRACE_SECONDS=2

# Seed: demo hisoblar uchun boshlang'ich parol (faqat mahalliy ishlab chiqish uchun!)
SEED_DEMO_PASSWORD="Demo2026!"
